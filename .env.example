# Copy to .env and edit.  cp .env.example .env

# Required: the library to scan, mounted read-only at /media
MEDIA_PATH=/mnt/media

# User/group the scans run as. Must be able to read MEDIA_PATH (id -u / id -g)
PUID=1000
PGID=1000

# Schedules run in this time zone
TZ=Etc/UTC

# Optional: resource caps (a decoder killed by the memory cap = BAD file)
#MEM_LIMIT=2g
#CPUS=4

# Optional: NVIDIA GPU decoding (NVDEC); needs nvidia-container-toolkit
#COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
